# URL publique du site (sans slash final). Sert au sitemap, aux balises canoniques et à IndexNow.
NEXT_PUBLIC_SITE_URL=https://www.formaroute.fr

# Formulaire de contact (Resend)
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend, ex. : Formaroute <contact@formaroute.fr>
CONTACT_FROM=
# Destinataire des messages (par défaut : l'email affiché sur le site)
CONTACT_EMAIL=

# Optionnel : jeton de vérification Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optionnel : protège POST /api/indexnow (Authorization: Bearer <secret>)
INDEXNOW_SUBMIT_SECRET=
